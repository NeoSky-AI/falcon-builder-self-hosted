# Falcon Builder — self-hosted configuration
#
# Run ./setup.sh: it copies this file to .env, asks for the public URL, and
# generates every secret. It never overwrites a value you have set. Then edit
# .env for SMTP (required for invitations and password resets) and the AI
# provider keys you want.

# ── Instance ────────────────────────────────────────────────────────────────
# Which release to run. A pinned tag moves only when you change it;
# "latest" follows every release.
FALCON_VERSION=v0.1.0
# Public origin of this instance, exactly as users see it in the browser.
# Laptop: http://localhost:3000 — Server: https://falcon.example.com
APP_URL=
# Where browsers reach file storage (presigned upload/download links).
# setup.sh derives it from APP_URL: http://localhost:9000 or https://<host>:9000
STORAGE_URL=
# Compose profiles. "storage" runs the bundled MinIO. Remove it to use your
# own S3-compatible bucket (see docs/storage.md).
COMPOSE_PROFILES=storage
# Host ports Caddy publishes. setup.sh sets HTTP_PORT from APP_URL
# (3000 for http://localhost:3000, 80 for a real domain).
HTTP_PORT=
HTTPS_PORT=443
STORAGE_PORT=9000

# ── Secrets (generated by setup.sh) ─────────────────────────────────────────
# Signs session cookies. Rotating it signs everyone out.
AUTH_SECRET=
# Encrypts every stored integration credential. LOSING IT ORPHANS THEM — back it up.
CREDENTIAL_ENCRYPTION_KEY=
# Signs invitation links.
INVITATION_TOKEN_SECRET=
# Signs end-user sessions on published interfaces.
INTERFACE_SESSION_SECRET=
# Authenticates the scheduler's calls to /api/cron/*.
CRON_SECRET=
# Database and bundled storage credentials.
POSTGRES_PASSWORD=
MINIO_ROOT_USER=falcon
MINIO_ROOT_PASSWORD=

# ── Email (required) ────────────────────────────────────────────────────────
# Your SMTP server. Sends invitations, password resets, interface OTP codes
# and workflow notifications. See docs/email.md.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Falcon Builder <noreply@example.com>"
SMTP_SECURE=
SMTP_TLS_REJECT_UNAUTHORIZED=

# ── AI providers ────────────────────────────────────────────────────────────
# Platform fallback keys for the AI nodes when a workflow has no credential of
# its own. OPENAI_API_KEY also powers knowledge-base embeddings (recommended).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
# Local models via Ollama, e.g. http://host.docker.internal:11434
OLLAMA_URL=
# Knowledge-base URL ingestion (https://app.tavily.com)
TAVILY_API_KEY=

# ── File storage ────────────────────────────────────────────────────────────
# Filled in by setup.sh for the bundled MinIO. For your own bucket, remove
# "storage" from COMPOSE_PROFILES and set these to it (docs/storage.md).
STORAGE_S3_BUCKET=falcon
STORAGE_S3_ENDPOINT=
STORAGE_S3_PUBLIC_ENDPOINT=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=
STORAGE_S3_PUBLIC_URL=

# ── Sign in with Google / Microsoft (optional) ──────────────────────────────
# Register your own OAuth apps with redirect URI
# <APP_URL>/api/auth-community/callback/google (or /microsoft). docs/auth.md.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_MICROSOFT_CLIENT_ID=
AUTH_MICROSOFT_CLIENT_SECRET=
AUTH_MICROSOFT_TENANT_ID=

# ── Worker ──────────────────────────────────────────────────────────────────
# Workflow executions one worker runs concurrently.
WORKER_CONCURRENCY=10
# Per-execution wall-clock timeout in ms (default 30 minutes).
EXECUTION_TIMEOUT_MS=

# ── Integrations (optional): OAuth apps that connect user accounts to nodes ─
# Each redirect URI is <APP_URL>/api/auth/<provider>/callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=
MICROSOFT_EXCEL_OAUTH_CLIENT_ID=
MICROSOFT_EXCEL_OAUTH_CLIENT_SECRET=
MICROSOFT_EXCEL_OAUTH_REDIRECT_URI=
SHAREPOINT_OAUTH_CLIENT_ID=
SHAREPOINT_OAUTH_CLIENT_SECRET=
SHAREPOINT_OAUTH_REDIRECT_URI=
ONEDRIVE_OAUTH_CLIENT_ID=
ONEDRIVE_OAUTH_CLIENT_SECRET=
ONEDRIVE_OAUTH_REDIRECT_URI=
SALESFORCE_OAUTH_CLIENT_ID=
SALESFORCE_OAUTH_CLIENT_SECRET=
SALESFORCE_OAUTH_REDIRECT_URI=
HIGHLEVEL_CLIENT_ID=
HIGHLEVEL_CLIENT_SECRET=
HIGHLEVEL_VERSION_ID=
HIGHLEVEL_OAUTH_REDIRECT_URI=

# ── Inbound email triggers (optional) ───────────────────────────────────────
# Workflows that start when an email arrives, through your Mailgun domain.
MAILGUN_API_KEY=
MAILGUN_WEBHOOK_SIGNING_KEY=
EMAIL_INBOUND_DOMAIN=

# ── MCP server (optional) ───────────────────────────────────────────────────
# Operator tokens for /api/mcp. Unset = MCP disabled.
MCP_ADMIN_TOKEN=
MCP_ADMIN_WRITE_TOKEN=

# ── Images ──────────────────────────────────────────────────────────────────
# Override to pull from a different registry or mirror.
FALCON_WEB_IMAGE=ghcr.io/neosky-ai/falcon-builder-web
FALCON_WORKER_IMAGE=ghcr.io/neosky-ai/falcon-builder-worker
